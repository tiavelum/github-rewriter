root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

# shfmt reads these for the shell scripts.
[*.sh]
shell_variant = posix
switch_case_indent = false
space_redirects = false

[*.md]
trim_trailing_whitespace = false
